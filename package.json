{
  "name": "super-agent",
  "displayName": "Super Agent",
  "description": "One agent leads, the team helps: Codex, Claude Code and Antigravity across all your accounts, with seamless hand-over when usage runs out.",
  "version": "0.3.7",
  "publisher": "touhidul-islam",
  "author": "Touhidul Islam",
  "license": "CC-BY-NC-4.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#4f46e5",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/touhid314/super-agent"
  },
  "homepage": "https://github.com/touhid314/super-agent#readme",
  "bugs": {
    "url": "https://github.com/touhid314/super-agent/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "codex",
    "claude code",
    "antigravity",
    "multi-agent",
    "ai agents",
    "telegram"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superAgent",
          "title": "Super Agent",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "superAgent.newThread",
          "when": "view == superAgent.team",
          "group": "navigation@1"
        },
        {
          "command": "superAgent.history",
          "when": "view == superAgent.team",
          "group": "navigation@2"
        },
        {
          "command": "superAgent.exportThread",
          "when": "view == superAgent.team",
          "group": "navigation@3"
        }
      ]
    },
    "views": {
      "superAgent": [
        {
          "type": "webview",
          "id": "superAgent.team",
          "name": "Super Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "superAgent.focus",
        "title": "Super Agent: Open Team"
      },
      {
        "command": "superAgent.newThread",
        "title": "New Thread",
        "category": "Super Agent",
        "icon": "$(add)"
      },
      {
        "command": "superAgent.history",
        "title": "Threads",
        "category": "Super Agent",
        "icon": "$(history)"
      },
      {
        "command": "superAgent.exportThread",
        "title": "Export Conversation",
        "category": "Super Agent",
        "icon": "$(export)"
      },
      {
        "command": "superAgent.addAccount",
        "title": "Super Agent: Add Agent Account"
      },
      {
        "command": "superAgent.stopAll",
        "title": "Super Agent: Stop All Agents"
      },
      {
        "command": "superAgent.connectTelegram",
        "title": "Super Agent: Connect Telegram"
      },
      {
        "command": "superAgent.telegram",
        "title": "Super Agent: Telegram Relay…"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir tests",
    "package": "node build.mjs && npx --yes @vscode/vsce package --no-dependencies --target win32-x64 && npx --yes @vscode/vsce package --no-dependencies --target win32-arm64",
    "publish": "node build.mjs && npx --yes @vscode/vsce publish --no-dependencies --target win32-x64 win32-arm64"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "^1.2.9",
    "markdown-it": "^14.1.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
