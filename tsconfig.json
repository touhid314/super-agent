{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "vscode"],
    "typeRoots": ["./node_modules/@types", "../super-agent/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "react": ["../super-agent/node_modules/@types/react"],
      "react/jsx-runtime": ["../super-agent/node_modules/@types/react/jsx-runtime"],
      "react-dom/client": ["../super-agent/node_modules/@types/react-dom/client"],
      "picomatch": ["../super-agent/node_modules/@types/picomatch"],
      "vitest": ["../super-agent/node_modules/vitest"]
    }
  },
  "include": ["src", "tests"]
}
